# ============================================================================
# Sen website — environment variables
# Copy this file to .env.local and fill in what you have.
#
# IMPORTANT: the site runs end-to-end with ALL of these unset — the marketing
# site renders entirely from typed sample data. Search the codebase for
# "TODO(api)" and "TODO(plug-in)" to find each seam to wire up later.
# ============================================================================

# ---------------------------------------------------------------------------
# Forecast API (the FastAPI backend in audvnd_output/serving/app.py)
# TODO(plug-in): point this at the deployed FastAPI service, e.g.
#   NEXT_PUBLIC_API_URL=https://api.sen.example
# When unset, the site renders from app/lib/forecast.ts (SAMPLE_FORECAST /
# SAMPLE_HISTORY) — the same shape the live /v1/forecast + /v1/history return.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — auth (and later: alert targets, user plans)
# TODO(plug-in): lib/supabase.ts, lib/auth.ts, middleware.ts,
#                components/LoginForm.tsx
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Resend — email (magic links, good-time alerts, weekly summary)
# TODO(plug-in): no email code exists yet; alerts UI is in
#                components/AlertForm.tsx, magic-link UI in
#                components/LoginForm.tsx
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
